# GitHub API
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=10
GITHUB_SEARCH_PER_PAGE=30
GITHUB_README_CANDIDATE_LIMIT=10
GITHUB_README_MAX_CHARS=4000

MIN_REPOSITORY_STARS=5

# DeepL Translation API
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
TRANSLATION_TIMEOUT_SECONDS=3.0
TRANSLATION_MAX_CHARS=1000

# Embedding
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Data
REPOSITORY_DATA_PATH=data/repositories.json

# ChromaDB
CHROMA_DB_DIR=data/vector_store
CHROMA_COLLECTION_NAME=github_readme_chunks

# README Chunking
README_CHUNK_SIZE=800
README_CHUNK_OVERLAP=120

# RAG
RAG_TOP_K_CHUNKS=10
RAG_MIN_SIMILARITY=0.55
